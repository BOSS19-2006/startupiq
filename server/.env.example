PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/startupiq
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI Provider config - the app runs in DEMO MODE (clearly labeled) if this is absent
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Admin seed (used only by `npm run seed`, never hardcoded in code)
ADMIN_EMAIL=admin@startupiq.local
ADMIN_PASSWORD=

MAX_UPLOAD_MB=10
ANALYSIS_RATE_LIMIT_PER_HOUR=10
